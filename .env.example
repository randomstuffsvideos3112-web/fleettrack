# Copy this file to .env and fill in your own values. Never share or commit .env.

# development (your PC) or production (internet server)
APP_ENV=development

# Leave as is for your PC. On a server, paste your PostgreSQL address here
# (for example from Neon: postgresql://user:password@host/dbname?sslmode=require)
DATABASE_URL=sqlite:///./fleettrack.db

# Long random text that protects sign-ins. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First control-room account, created on the very first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Control Room

# Optional tuning
# OVERSPEED_TOLERANCE_KMH=5     # alert only above limit + this
# STALE_AFTER_SECONDS=120       # "signal lost" after this long without an update
# OFFLINE_AFTER_SECONDS=600     # "offline" after this long
# MAX_ACCURACY_METERS=50        # ignore GPS fixes worse than this for distance
# TOKEN_HOURS_ADMIN=12
# TOKEN_HOURS_DRIVER=168
